GEOBOUNDARIES_API="https://www.geoboundaries.org/api"
# Source = raw per-country GeoJSON from the API's pinned GitHub commit links; output = the SQLite
# files GeoBoundariesService reads at runtime (APP_SHARED_DIRECTORY/geoboundaries-data).
GEOBOUNDARIES_SOURCE_DIR="${HOME}/data/geoboundaries-source"
GEOBOUNDARIES_OUTPUT_DIR="${HOME}/data/geoboundaries-data"
# geonames-bundle's geo.sqlite, used by `crosswalk` to link boundaries to GeoNames ids.
GEONAMES_DATA_DIR="${HOME}/data/geonames-data"
HF_ACCOUNT="museado"
